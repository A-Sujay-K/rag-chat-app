# Toggle between providers: "openai" or "ollama"
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=huggingface

# ──────────────────────────────────────────────
# OpenAI Settings (only needed when provider = openai)
# ──────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ──────────────────────────────────────────────
# Ollama Settings (only needed when provider = ollama)
# ──────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

